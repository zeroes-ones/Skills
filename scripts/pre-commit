#!/usr/bin/env bash
# =============================================================================
# Pre-Commit Hook — Skills Quality Gate
# Blocks commits that fail any validation check.
# Install: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
# =============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$REPO_ROOT"

echo ""
echo "╔══════════════════════════════════════════╗"
echo "║  Pre-Commit: Skills Validation Gate      ║"
echo "╚══════════════════════════════════════════╝"
echo ""

# Only run if skills/ or scripts/ changed
if ! git diff --cached --name-only | grep -qE '^(skills/|scripts/)'; then
    echo "  No skill/script changes detected. Skipping gate."
    exit 0
fi

echo "  Changes detected in skills/ or scripts/. Running full validation..."
echo ""

# Run the main validation suite
bash "$SCRIPT_DIR/validate-skills.sh"
VALIDATION_RC=$?

echo ""

if [[ $VALIDATION_RC -ne 0 ]]; then
    echo "╔══════════════════════════════════════════╗"
    echo "║  ❌ COMMIT BLOCKED                       ║"
    echo "║  Fix the failures above and try again.   ║"
    echo "╚══════════════════════════════════════════╝"
    exit 1
fi

# Run evals harness (informational only — does not block commit)
if [[ -f "$SCRIPT_DIR/run-evals.sh" ]]; then
    echo ""
    echo "  Running evals harness (informational)..."
    bash "$SCRIPT_DIR/run-evals.sh" --summary 2>&1 | tail -5 || true
fi

echo ""
echo "╔══════════════════════════════════════════╗"
echo "║  ✅ All gates passed. Commit allowed.     ║"
echo "╚══════════════════════════════════════════╝"
exit 0
