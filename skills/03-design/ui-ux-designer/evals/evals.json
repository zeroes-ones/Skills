{
  "$schema": "https://agentskills.io/schemas/evals/v1",
  "version": "1.0.0",
  "skill": "ui-ux-designer",
  "description": "Per-skill evaluation for ui-ux-designer \u2014 validates trigger routing, output quality, anti-pattern compliance, and progressive disclosure.",
  "train_split": 0.6,
  "trigger_threshold": 0.5,
  "runs_per_query": 3,
  "scenarios": [
    {
      "id": "trigger-ui-ux-designer-primary",
      "category": "trigger_routing",
      "description": "Agent should activate ui-ux-designer for primary domain request",
      "input": "I need help with quick: 30s -- scan the bullet list to decide if this skill fits --> \u2014 can you guide me?",
      "expected_behavior": "skill_activated",
      "assertions": [
        {
          "type": "skill_activated",
          "skill": "ui-ux-designer"
        },
        {
          "type": "output_contains",
          "patterns": [
            "design system",
            "responsive",
            "handoff"
          ]
        }
      ]
    },
    {
      "id": "trigger-ui-ux-designer-complex",
      "category": "trigger_routing",
      "description": "Agent should activate for complex ui-ux-designer scenario",
      "input": "I'm working on a product needs a design system built or extended with new components \u2014 what are the best practices?",
      "expected_behavior": "skill_activated",
      "assertions": [
        {
          "type": "skill_activated",
          "skill": "ui-ux-designer"
        },
        {
          "type": "output_contains",
          "patterns": [
            "design system",
            "responsive"
          ]
        }
      ]
    },
    {
      "id": "trigger-ui-ux-designer-ambiguous",
      "category": "trigger_routing",
      "description": "Agent should activate ui-ux-designer for ambiguous domain-adjacent request",
      "input": "How should I approach ui ux designer for a team of 5 engineers?",
      "expected_behavior": "skill_activated",
      "assertions": [
        {
          "type": "skill_activated",
          "skill": "ui-ux-designer"
        }
      ]
    },
    {
      "id": "negative-ui-ux-designer-1",
      "category": "negative_trigger",
      "description": "Should NOT activate ui-ux-designer for off-domain request: frontend implementation",
      "input": "I need to frontend implementation",
      "expected_behavior": "skill_not_activated",
      "assertions": [
        {
          "type": "skill_not_activated",
          "skill": "ui-ux-designer"
        }
      ]
    },
    {
      "id": "negative-ui-ux-designer-2",
      "category": "negative_trigger",
      "description": "Should NOT activate ui-ux-designer for off-domain request: accessibility auditing",
      "input": "I need to accessibility auditing",
      "expected_behavior": "skill_not_activated",
      "assertions": [
        {
          "type": "skill_not_activated",
          "skill": "ui-ux-designer"
        }
      ]
    },
    {
      "id": "output-anti-patterns-ui-ux-designer",
      "category": "anti_pattern_compliance",
      "description": "Output should not contain common ui-ux-designer anti-patterns",
      "input": "Build a production-ready ui ux designer implementation for a startup",
      "expected_behavior": "skill_activated",
      "assertions": [
        {
          "type": "output_not_contains",
          "patterns": [
            "hardcoded secret",
            "console.log(password",
            "TODO: fix",
            "eval("
          ]
        },
        {
          "type": "output_contains",
          "patterns": [
            "design-system",
            "api"
          ]
        }
      ]
    },
    {
      "id": "checklist-coverage-ui-ux-designer",
      "category": "checklist_coverage",
      "description": "Output should cover key production checklist items for ui-ux-designer",
      "input": "I'm shipping a ui ux designer project to production \u2014 what should I verify before launch?",
      "expected_behavior": "skill_activated",
      "assertions": [
        {
          "type": "output_contains",
          "patterns": [
            "design tokens",
            "exported as json",
            "scss and imported by",
            "all platforms without manual"
          ]
        }
      ]
    },
    {
      "id": "output-quality-ui-ux-designer",
      "category": "output_quality",
      "description": "Output should be specific and actionable for ui-ux-designer",
      "input": "What's the most important thing to know about ui ux designer?",
      "expected_behavior": "skill_activated",
      "assertions": [
        {
          "type": "output_not_contains",
          "patterns": [
            "it depends",
            "could be anything",
            "I'm not sure",
            "maybe"
          ]
        },
        {
          "type": "output_contains",
          "patterns": [
            "specific",
            "example"
          ]
        }
      ]
    }
  ]
}
