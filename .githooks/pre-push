#!/usr/bin/env bash
# ==============================================================================
# Pre-push: CI Mirror Gate — blocks push on any CI-mirrored failure.
# Delegates to scripts/run-ci-locally.sh which mirrors .github/workflows/validate.yml
# ==============================================================================
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}  Pre-push: CI Mirror Gate${NC}"
echo -e "${GREEN}  Running scripts/run-ci-locally.sh${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# ── Gate 0: Copilot co-author check (blocking) ───────────────────────────
echo ""
echo "[0] Copilot co-author trailer check..."
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue  # Branch being deleted
    fi
    if git rev-parse -q --verify "$remote_sha" >/dev/null 2>&1; then
        range="${remote_sha}..${local_sha}"
    else
        range="$local_sha"
    fi
    copilot_count=$(git log "$range" --format='%B' --grep='Co-authored-by.*Copilot' -i --oneline 2>/dev/null | wc -l | tr -d ' ')
    if [ "${copilot_count:-0}" -gt 0 ]; then
        echo -e "  ${RED}✗${NC} Found ${copilot_count} commit(s) with Copilot co-author trailers"
        echo "  Amend offending commits or run: git filter-branch -f --msg-filter \"sed '/^Co-authored-by:.*Copilot/Id'\" main"
        exit 1
    fi
done
echo -e "  ${GREEN}✓${NC} No Copilot co-author trailers"

# ── Gate 1: CI Mirror (same as GitHub Actions) ──────────────────────────
echo ""
if [ -f "$REPO_ROOT/scripts/run-ci-locally.sh" ]; then
    bash "$REPO_ROOT/scripts/run-ci-locally.sh" "$@"
else
    echo "❌ scripts/run-ci-locally.sh not found — push blocked."
    exit 1
fi
