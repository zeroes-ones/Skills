#!/usr/bin/env bash
# ==============================================================================
# Pre-commit: Comprehensive Lint & Validate
# ==============================================================================
# Runs 15 gates on all staged files before any commit is accepted:
#
#   G0  Script integrity (SHA256 manifest)
#   G1  File format (UTF-8, LF, trailing whitespace, final newline, tabs)
#   G2  Shell script (shebang, strict mode, quoting, trap cleanup)
#   G3  YAML frontmatter (valid, description ≤1024, trigger format, chain refs)
#   G4  Markdown style (headings, whitespace, code blocks, bare URLs)
#   G5  JSON validity (evals/*.json, package.json, etc.)
#   G6  Template compliance (14 sections, anti-hallucination, gotchas, ground rules)
#   G7  Completion criteria (≥8 "Complete when" statements)
#   G8  Decision trees (≥3 under ## Decision Trees)
#   G9  Chain connectivity (consumes_from + feeds_into)
#   G10 Reference link integrity (all references/*.md resolve)
#   G11 Verify script existence (scripts/verify-skill.sh + references/)
#   G12 Portability target declaration
#   G13 Example validation (real-world backtest-verified examples)
#   G14 Deep research gate (data provenance, regime coverage, pattern engine, failure modes)
#
# Target: <5 seconds for typical commits. Full suite runs in pre-push.
# ==============================================================================
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

fail() { echo -e "  ${RED}✗${NC} $1"; }
pass() { echo -e "  ${GREEN}✓${NC} $1"; }
warn() { echo -e "  ${YELLOW}⚠${NC} $1"; }

# Get all staged files
STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)
STAGED_SKILLS=$(echo "$STAGED" | grep '/SKILL.md$' || true)
STAGED_SH=$(echo "$STAGED" | grep '\.sh$' || true)
STAGED_JSON=$(echo "$STAGED" | grep '\.json$' || true)
STAGED_SCRIPTS=$(echo "$STAGED" | grep -E '^(scripts/.*\.(sh|py)|skills/.*/scripts/.*\.(sh|py)|\.githooks/.*)$' || true)

errors=0
warnings=0

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Pre-commit: 15-Gate Lint, Validate & Deep Research"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# ═══════════════════════════════════════════════════════════════════════════
# G0: Script integrity (only when scripts change)
# ═══════════════════════════════════════════════════════════════════════════
if [ -n "$STAGED_SCRIPTS" ] && [ -f "$REPO_ROOT/scripts/verify-script-integrity.sh" ]; then
    if [ -f "$REPO_ROOT/scripts/generate-sha256-manifest.sh" ]; then
        bash "$REPO_ROOT/scripts/generate-sha256-manifest.sh" --quiet 2>/dev/null || true
        git add "$REPO_ROOT/scripts/.sha256manifest" 2>/dev/null || true
    fi
    if bash "$REPO_ROOT/scripts/verify-script-integrity.sh" 2>/dev/null; then
        pass "G0  Script integrity (SHA256 manifest)"
    else
        fail "G0  Script integrity — manifest mismatch. Re-stage and commit again."
        errors=$((errors + 1))
    fi
fi

# ═══════════════════════════════════════════════════════════════════════════
# G1: File format — runs on ALL staged files (blocking)
# ═══════════════════════════════════════════════════════════════════════════
if [ -n "$STAGED" ]; then
    fmt_output=$(python3 "$REPO_ROOT/scripts/lib/lint-files.py" --changed --errors-only --no-color 2>/dev/null) && fmt_ok=true || fmt_ok=false
    if $fmt_ok; then
        pass "G1  File format (UTF-8, LF, no trailing whitespace, final newline, no tabs)"
    else
        fail "G1  File format"
        echo "$fmt_output" | head -20
        errors=$((errors + 1))
    fi
fi

# ═══════════════════════════════════════════════════════════════════════════
# G2: Shell script lint (only when .sh files staged)
# ═══════════════════════════════════════════════════════════════════════════
if [ -n "$STAGED_SH" ]; then
    sh_output=$(python3 "$REPO_ROOT/scripts/lib/lint-shell.py" --changed --errors-only --no-color 2>/dev/null) && sh_ok=true || sh_ok=false
    if $sh_ok; then
        pass "G2  Shell script (shebang, set -euo pipefail, [[ ]], $(), read -r, trap)"
    else
        fail "G2  Shell script"
        echo "$sh_output" | head -20
        errors=$((errors + 1))
    fi
fi

# ═══════════════════════════════════════════════════════════════════════════
# G3-G12: Skill-specific gates (only if SKILL.md staged)
# ═══════════════════════════════════════════════════════════════════════════
if [ -n "$STAGED_SKILLS" ]; then
    # Strip 00-framework skills from template checks
    NON_FW_SKILLS=$(echo "$STAGED_SKILLS" | grep -v '00-framework' || true)

    # ── G3: JSON validity ─────────────────────────────────────────────────
    if [ -n "$STAGED_JSON" ]; then
        json_output=$(python3 -c "
import json, sys, subprocess
errs = 0
for f in '''$STAGED_JSON'''.strip().split('\n'):
    if not f: continue
    try:
        with open(f) as fh: json.load(fh)
    except json.JSONDecodeError as e:
        print(f'  {f}: {e}', file=sys.stderr)
        errs += 1
    except Exception as e:
        print(f'  {f}: {e}', file=sys.stderr)
        errs += 1
sys.exit(min(errs, 1))
" 2>/dev/null) && json_ok=true || json_ok=false
        if $json_ok; then
            pass "G3  JSON validity"
        else
            fail "G3  JSON validity"
            echo "$json_output"
            errors=$((errors + 1))
        fi
    fi

    # ── G4: YAML frontmatter ──────────────────────────────────────────────
    yaml_output=$(python3 "$REPO_ROOT/scripts/lib/lint-yaml.py" --changed --errors-only --no-color 2>/dev/null) && yaml_ok=true || yaml_ok=false
    if $yaml_ok; then
        pass "G4  YAML frontmatter (valid, description \u22641024, trigger format, name=dir, chain refs)"
    else
        fail "G4  YAML frontmatter"
        echo "$yaml_output" | head -15
        errors=$((errors + 1))
    fi

    # ── G5: Markdown style ────────────────────────────────────────────────
    md_output=$(python3 "$REPO_ROOT/scripts/lib/lint-markdown.py" --changed --errors-only --no-color 2>/dev/null) && md_ok=true || md_ok=false
    if $md_ok; then
        pass "G5  Markdown style (headings, blank lines, code fences, no duplicate headings, no tabs)"
    else
        fail "G5  Markdown style"
        echo "$md_output" | head -15
        errors=$((errors + 1))
    fi

    # ── G6: Template compliance (14 sections + anti-hallucination + gotchas + ground rules) ──
    if [ -n "$NON_FW_SKILLS" ]; then
        tmpl_output=$(python3 "$REPO_ROOT/scripts/lib/lint-template.py" --changed --no-color 2>/dev/null) && tmpl_ok=true || tmpl_ok=false
        if $tmpl_ok; then
            pass "G6  Template compliance (14 sections, anti-hallucination, ground rules structure)"
        else
            # Separate errors from warnings
            err_count=$(echo "$tmpl_output" | grep -c '✗' || true)
            wrn_count=$(echo "$tmpl_output" | grep -c '⚠' || true)
            if [ "${err_count:-0}" -gt 0 ]; then
                fail "G6  Template compliance"
                echo "$tmpl_output" | head -25
                errors=$((errors + 1))
            else
                pass "G6  Template compliance"
                if [ "${wrn_count:-0}" -gt 0 ]; then
                    echo "$tmpl_output" | head -10
                    warnings=$((warnings + 1))
                fi
            fi
        fi
    fi

    # ── G7: Completion criteria (fast grep check) ─────────────────────────
    comp_failures=0
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        [ ! -f "$REPO_ROOT/$f" ] && continue
        count=$(grep -ci 'Complete when' "$REPO_ROOT/$f" 2>/dev/null || true)
        count=${count:-0}
        if [ "$count" -lt 8 ] 2>/dev/null; then
            echo "  ✗ $f: only $count 'Complete when' criteria (need \u22658)"
            comp_failures=$((comp_failures + 1))
        fi
    done <<< "$NON_FW_SKILLS"
    if [ "$comp_failures" -eq 0 ]; then
        pass "G7  Completion criteria (\u22658 'Complete when' statements)"
    else
        fail "G7  Completion criteria — $comp_failures skill(s) below minimum"
        errors=$((errors + 1))
    fi

    # ── G8: Decision trees count (\u22653) ────────────────────────────────────
    dt_failures=0
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        [ ! -f "$REPO_ROOT/$f" ] && continue
        dt_count=$(sed -n '/^## Decision Trees/,/^## Gotchas/p' "$REPO_ROOT/$f" 2>/dev/null | grep -c '^###' || true)
        dt_count=${dt_count:-0}
        if [ "$dt_count" -lt 3 ] 2>/dev/null; then
            echo "  ✗ $f: only $dt_count decision tree(s) (need \u22653)"
            dt_failures=$((dt_failures + 1))
        fi
    done <<< "$NON_FW_SKILLS"
    if [ "$dt_failures" -eq 0 ]; then
        pass "G8  Decision trees (\u22653 under ## Decision Trees)"
    else
        fail "G8  Decision trees — $dt_failures skill(s) below minimum"
        errors=$((errors + 1))
    fi

    # ── G9: Chain connectivity ────────────────────────────────────────────
    chain_failures=0
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        [ ! -f "$REPO_ROOT/$f" ] && continue
        if ! grep -q 'consumes_from' "$REPO_ROOT/$f"; then
            echo "  ✗ $f: missing consumes_from (no upstream)"
            chain_failures=$((chain_failures + 1))
        fi
        if ! grep -q 'feeds_into' "$REPO_ROOT/$f"; then
            echo "  ✗ $f: missing feeds_into (no downstream)"
            chain_failures=$((chain_failures + 1))
        fi
    done <<< "$NON_FW_SKILLS"
    if [ "$chain_failures" -eq 0 ]; then
        pass "G9  Chain connectivity (consumes_from + feeds_into present)"
    else
        fail "G9  Chain connectivity — $chain_failures missing connection(s)"
        errors=$((errors + 1))
    fi

    # ── G10: Reference link integrity ─────────────────────────────────────
    python3 -c "
import os, re, sys
changed = '''$STAGED_SKILLS'''.strip().split('\n')
errs = 0
for f in changed:
    if not f or not f.endswith('/SKILL.md'):
        continue
    path = os.path.join('$REPO_ROOT', f)
    if not os.path.exists(path):
        continue
    with open(path) as fh:
        content = fh.read()
    for m in re.finditer(r'\(references/([^)]+)\)', content):
        ref_file = os.path.join(os.path.dirname(path), 'references', m.group(1))
        if not os.path.exists(ref_file):
            print(f'  ✗ BROKEN LINK references/{m.group(1)} in {f}', file=sys.stderr)
            errs += 1
sys.exit(min(errs, 1))
" 2>/dev/null && ref_ok=true || ref_ok=false
    if $ref_ok; then
        pass "G10 Reference link integrity (all references/*.md resolve)"
    else
        fail "G10 Reference link integrity"
        errors=$((errors + 1))
    fi

    # ── G11: Verify script + references/ dir ──────────────────────────────
    python3 -c "
import os, sys
changed = '''$STAGED_SKILLS'''.strip().split('\n')
errs = 0
for f in changed:
    if not f or not f.endswith('/SKILL.md') or '00-framework' in f:
        continue
    skill_dir = os.path.dirname(os.path.join('$REPO_ROOT', f))
    verify_script = os.path.join(skill_dir, 'scripts', 'verify-skill.sh')
    if not os.path.exists(verify_script) or not os.access(verify_script, os.X_OK):
        print(f'  ✗ MISSING scripts/verify-skill.sh (or not executable): {f}', file=sys.stderr)
        errs += 1
    refs_dir = os.path.join(skill_dir, 'references')
    if not os.path.isdir(refs_dir):
        print(f'  ✗ MISSING references/ directory: {f}', file=sys.stderr)
        errs += 1
sys.exit(min(errs, 1))
" 2>/dev/null && struct_ok=true || struct_ok=false
    if $struct_ok; then
        pass "G11 Per-skill artifacts (verify-skill.sh executable + references/ dir)"
    else
        fail "G11 Per-skill artifacts"
        errors=$((errors + 1))
    fi

    # ── G12: Portability target ───────────────────────────────────────────
    port_failures=0
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        [ ! -f "$REPO_ROOT/$f" ] && continue
        if ! grep -q 'Portability target' "$REPO_ROOT/$f"; then
            echo "  ✗ $f: missing portability target"
            port_failures=$((port_failures + 1))
        fi
    done <<< "$NON_FW_SKILLS"
    if [ "$port_failures" -eq 0 ]; then
        pass "G12 Portability target declared"
    else
        fail "G12 Portability target — $port_failures skill(s) missing declaration"
        errors=$((errors + 1))
    fi

    # ── G13: Example validation (new skills must have real-world examples) ──
    if [ -f "$REPO_ROOT/scripts/lib/validate-skill-examples.sh" ]; then
        example_output=$(bash "$REPO_ROOT/scripts/lib/validate-skill-examples.sh" --changed --no-color --errors-only 2>&1) && ex_ok=true || ex_ok=false
        if $ex_ok; then
            pass "G13 Example validation (real-world backtest example present)"
        else
            fail "G13 Example validation — new/missing skills require backtest-verified examples"
            echo "$example_output" | head -15
            errors=$((errors + 1))
        fi
    else
        warn "G13 Example validation script not found — skipping"
        warnings=$((warnings + 1))
    fi

    # ── G14: Deep research gate — data provenance, regimes, pattern engine ──
    if [ -f "$REPO_ROOT/scripts/lib/deep-research-gate.sh" ]; then
        research_output=$(bash "$REPO_ROOT/scripts/lib/deep-research-gate.sh" --changed --no-color 2>&1) && research_ok=true || research_ok=false
        if $research_ok; then
            pass "G14 Deep research gate (provenance, regime coverage, pattern engine, failure modes)"
        else
            fail "G14 Deep research gate — insufficient research depth. Provenance tags, regime coverage, and pattern engine required."
            echo "$research_output" | grep -E 'BLOCK|WARN|PASS' | head -20
            errors=$((errors + 1))
        fi
    else
        warn "G14 Deep research gate script not found — skipping"
        warnings=$((warnings + 1))
    fi
fi

# ═══════════════════════════════════════════════════════════════════════════
# Summary
# ═══════════════════════════════════════════════════════════════════════════
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [ "$errors" -eq 0 ] && [ "$warnings" -eq 0 ]; then
    echo -e "  ${GREEN}✅ All 15 pre-commit gates passed${NC}"
elif [ "$errors" -eq 0 ]; then
    echo -e "  ${YELLOW}⚠  All gates passed with $warnings warning(s)${NC}"
else
    echo -e "  ${RED}❌ Pre-commit FAILED — $errors gate(s) failed${NC}"
    echo ""
    echo "  Quick fixes:"
    echo "    ./scripts/lint.sh --fix              # Auto-fix formatting"
    echo "    ./scripts/lint.sh --all              # Full lint report"
    echo "    ./scripts/lint.sh --category yaml    # YAML-only check"
    echo "    python3 scripts/lib/lint-template.py --changed  # Template check"
fi
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

exit $errors
