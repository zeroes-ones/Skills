{
  "name": "@zeroes-ones/skills",
  "version": "2.0.0",
  "description": "297 agent-agnostic skills covering the full company lifecycle — from CEO vision through architecture, development, security, compliance, and operations. Installer/activator CLI (npx @zeroes-ones/skills init).",
  "license": "MIT",
  "author": "Sandeep Kumar Penchala",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeroes-ones/Skills"
  },
  "homepage": "https://github.com/zeroes-ones/Skills#readme",
  "keywords": [
    "ai-skills",
    "agent-skills",
    "claude-code",
    "copilot-cli",
    "cursor",
    "gemini-cli",
    "codex",
    "skills-library",
    "software-engineering",
    "product-development",
    "code-review",
    "security",
    "devops"
  ],
  "bin": {
    "skills": "./scripts/npx-skills.sh",
    "skills-init": "./scripts/init-project.sh",
    "skills-update": "./scripts/install.sh",
    "skills-validate": "./scripts/validate-skills.sh",
    "skills-lint": "./scripts/lint.sh"
  },
  "files": [
    "scripts/",
    "docs/",
    "README.md",
    "QUICKSTART.md"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "test": "bash scripts/run-evals.sh",
    "lint": "bash scripts/lint.sh --all",
    "validate": "bash scripts/validate-skills.sh",
    "prepublishOnly": "bash scripts/lint.sh --all && bash scripts/validate-skills.sh"
  }
