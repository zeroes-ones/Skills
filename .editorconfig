# EditorConfig — consistent editor settings across all contributors
# https://editorconfig.org

root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 2

[*.md]
indent_size = 2

[*.py]
indent_size = 4

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab

[*.{yaml,yml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{js,ts}]
indent_size = 2
